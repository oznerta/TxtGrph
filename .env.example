# Public client Supabase configuration (exposed to browser bundle)
PUBLIC_SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_ID>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# Server-only administrative key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Server-only AES-256 root key for Phase 3 BYOK Vault encryption (min 32 chars)
VAULT_ROOT_KEY=<YOUR_32_CHAR_VAULT_ROOT_KEY>

# Node runtime environment (development | production | test)
NODE_ENV=development
